<Window x:Class="AtmWinFormsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Банкомат - Політех Банк" Height="520" Width="450"
        WindowStartupLocation="CenterScreen" Background="#2C3E50" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Border Background="#ECF0F1" CornerRadius="10" Padding="20">
            <Grid>
                <!-- Панель входу (Аутентифікація) -->
                <StackPanel x:Name="PanelLogin" VerticalAlignment="Center">
                    <TextBlock Text="ВХІД У БАНКОМАТ" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#2C3E50"/>

                    <TextBlock Text="Номер картки (напр. 1111222233334444):" Margin="0,5,0,2"/>
                    <TextBox x:Name="TxtCardNumber" Height="30" FontSize="14" VerticalContentAlignment="Center" Text="1111222233334444"/>

                    <TextBlock Text="ПІН-код (напр. 1234):" Margin="0,10,0,2"/>
                    <PasswordBox x:Name="TxtPin" Height="30" FontSize="14" VerticalContentAlignment="Center" Password="1234"/>

                    <Button Content="Увійти" Height="40" Margin="0,20,0,0" 
                            Background="#27AE60" Foreground="White" FontWeight="Bold"
                            Click="BtnLogin_Click"/>
                </StackPanel>

                <!-- Панель операцій банкомата -->
                <StackPanel x:Name="PanelMenu" Visibility="Collapsed">
                    <TextBlock x:Name="TxtWelcome" Text="Меню банкомата" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#2C3E50"/>

                    <Button Content="Переглянути баланс" Height="38" Margin="0,0,0,10"
                            Background="#2980B9" Foreground="White" FontWeight="Bold"
                            Click="BtnBalance_Click"/>

                    <Separator Margin="0,5"/>

                    <TextBlock Text="Сума операції (грн):" Margin="0,5,0,2"/>
                    <TextBox x:Name="TxtAmount" Height="30" FontSize="14" VerticalContentAlignment="Center"/>

                    <UniformGrid Columns="2" Margin="0,10,0,10">
                        <Button Content="Зняти кошти" Height="38" Margin="0,0,5,0"
                                Background="#E67E22" Foreground="White" FontWeight="Bold"
                                Click="BtnWithdraw_Click"/>
                        <Button Content="Поповнити картку" Height="38" Margin="5,0,0,0"
                                Background="#16A085" Foreground="White" FontWeight="Bold"
                                Click="BtnDeposit_Click"/>
                    </UniformGrid>

                    <Separator Margin="0,5"/>

                    <TextBlock Text="Номер картки отримувача (напр. 5555666677778888):" Margin="0,5,0,2"/>
                    <TextBox x:Name="TxtTargetCard" Height="30" FontSize="14" VerticalContentAlignment="Center" Text="5555666677778888"/>

                    <Button Content="Перерахувати на іншу картку" Height="38" Margin="0,10,0,15"
                            Background="#8E44AD" Foreground="White" FontWeight="Bold"
                            Click="BtnTransfer_Click"/>

                    <Button Content="Завершити сеанс (Повернути картку)" Height="35"
                            Background="#C0392B" Foreground="White" FontWeight="Bold"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>